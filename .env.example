# ─────────────────────────────────────────────────────────────
# Echo · English Phone Coach — environment variables
# Copy to `.env.local` for local development, or paste into
# Vercel → Project → Settings → Environment Variables.
# NEVER commit .env.local (it is already git-ignored).
# ─────────────────────────────────────────────────────────────

# [Required] OpenAI — transcription, coaching, and TTS
OPENAI_API_KEY=sk-...

# [Optional] Model overrides (defaults shown)
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# [Optional] Azure Speech — pronunciation assessment (Phoneme granularity)
# Leave empty to run the OpenAI-only pipeline. You can also enter these
# keys in the app's Settings screen (sent per-request, never stored on the server).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
